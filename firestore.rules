rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sachin@gmail.com' ||
        request.auth.token.email == 'dhruv@gmail.com' ||
        request.auth.token.email == 'elizabeth@gmail.com' ||
        request.auth.token.email == 'sanjanayadav02072007@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin & User Profiles Collection (/admin/{userId})
    match /admin/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        resource == null
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin()
      );
      allow delete: if isAdmin();

      // Subcollections under admin (e.g., /admin/{userId}/users/{appointmentId})
      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Users Collection (Profile and central appointments /users/{docId})
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        resource == null || 
        resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );

      // Subcollections under users (e.g., /users/{userId}/appointments/{appointmentId})
      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Central Hospital All Appointments Collection (Legacy & compatibility)
    match /all_appointments/{appointmentId} {
      allow get: if isSignedIn() && (
        isAdmin() || 
        resource == null || 
        resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
    }

    // Allow test connection ping
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

